# ==============================================================================
# SPARK — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. DATABASE & ORM (Supabase PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Transaction pooler (Port 6543): Application runtime queries with pgBouncer
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (Port 5432): Direct database operations and Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. SESSION SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
AUTH_SECRET="your-32-character-random-auth-secret"

# ------------------------------------------------------------------------------
# 5. NEXCONN CHAT SDK (Real-Time Communication & Channels)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NEXCONN_APP_KEY="your-nexconn-app-key"
NEXCONN_APP_KEY="your-nexconn-app-key"
NEXCONN_APP_SECRET="your-nexconn-app-secret"
NEXCONN_API_BASE_URL="https://api-sg.nexconn.ai"
# NEXCONN_DATA_CENTER="SG" # Regional cluster: SG, NA, US, BJ, CN

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE (SPARK AI Assistant)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"
# GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL NOTIFICATIONS & STORAGE
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="SPARK <noreply@yourdomain.com>"
NEXT_PUBLIC_STORAGE_BUCKET_NAME="spark-assets"
