generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownedWorkspaces Workspace[]           @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sentInvitations WorkspaceInvitation[] @relation("InvitedByUser")
  createdChannels WorkspaceChatChannel[] @relation("ChannelCreator")
  channelMemberships ChatChannelMember[]
  directConversationsAsUser1 ChatDirectConversation[] @relation("ConversationUser1")
  directConversationsAsUser2 ChatDirectConversation[] @relation("ConversationUser2")
  pinnedArtifacts ChatPinnedArtifact[] @relation("PinnedByUser")
  assignedTasks   Task[]               @relation("TaskAssignee")
  createdTasks    Task[]               @relation("TaskCreator")
  createdMeetings ScheduledMeeting[]   @relation("MeetingCreator")
  notifications   Notification[]       @relation("UserNotifications")
  joinRequests    WorkspaceJoinRequest[]
  handoverAcknowledgments ChatHandoverAcknowledgment[]
  ownedProjects   Project[]            @relation("ProjectOwner")
  taskComments    TaskComment[]
  projectMemberships ProjectMember[]
  taskActivities  TaskActivity[]
  taskAttachments TaskAttachment[]

  @@map("users")
}

model Workspace {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  type        WorkspaceType @default(ORGANIZATION)
  avatarUrl   String?       @map("avatar_url")
  joinCode    String?       @unique @map("join_code")
  isPrivate   Boolean       @default(false) @map("is_private")
  ownerId     String        @map("owner_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  settings    WorkspaceSettings?
  channels    WorkspaceChatChannel[]
  directConversations ChatDirectConversation[]
  projects    Project[]
  tasks       Task[]
  sprints     Sprint[]
  taskActivities TaskActivity[]
  taskAttachments TaskAttachment[]
  taskDependencies TaskDependency[]
  milestones  ProjectMilestone[]
  meetings    ScheduledMeeting[]
  notifications Notification[]
  joinRequests WorkspaceJoinRequest[]
  handoverAcknowledgments ChatHandoverAcknowledgment[]

  @@index([ownerId])
  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique @map("token_hash")
  invitedBy   String        @map("invited_by") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User          @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model WorkspaceSettings {
  id                     String        @id @default(uuid()) @db.Uuid
  workspaceId            String        @unique @map("workspace_id") @db.Uuid
  defaultMemberRole      WorkspaceRole @default(MEMBER) @map("default_member_role")
  allowMemberInvitations Boolean       @default(true) @map("allow_member_invitations")
  allowGuestAccess       Boolean       @default(false) @map("allow_guest_access")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  // Relations
  workspace              Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

enum ChatChannelType {
  PUBLIC
  PRIVATE
}

model WorkspaceChatChannel {
  id               String               @id @default(uuid()) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  nexconnChannelId String               @unique @map("nexconn_channel_id")
  name             String
  description      String?
  type             ChatChannelType      @default(PUBLIC)
  joinCode         String?              @unique @map("join_code")
  isDefault        Boolean              @default(false) @map("is_default")
  createdById      String               @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  // Relations
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User                 @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members          ChatChannelMember[]
  pinnedArtifacts  ChatPinnedArtifact[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([nexconnChannelId])
  @@map("workspace_chat_channels")
}

model ChatChannelMember {
  id        String               @id @default(uuid()) @db.Uuid
  channelId String               @map("channel_id") @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  joinedAt  DateTime             @default(now()) @map("joined_at")

  // Relations
  channel   WorkspaceChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
  @@map("chat_channel_members")
}

model ChatDirectConversation {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  user1Id       String    @map("user1_id") @db.Uuid
  user2Id       String    @map("user2_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user1         User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([workspaceId, user1Id, user2Id])
  @@index([workspaceId])
  @@index([user1Id])
  @@index([user2Id])
  @@map("chat_direct_conversations")
}

model ChatPinnedArtifact {
  id         String               @id @default(uuid()) @db.Uuid
  channelId  String               @map("channel_id") @db.Uuid
  title      String
  url        String
  pinnedById String               @map("pinned_by_id") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at")

  // Relations
  channel    WorkspaceChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy   User                 @relation("PinnedByUser", fields: [pinnedById], references: [id], onDelete: Restrict)

  @@index([channelId])
  @@map("chat_pinned_artifacts")
}

enum NotificationType {
  CHAT_DM
  CHAT_CHANNEL
  SHIFT_HANDOVER
  WORKSPACE_INVITATION
  WORKSPACE_JOIN_REQUEST
  MEMBER_JOINED
  MEETING_SCHEDULED
  TASK_ASSIGNED
  TASK_DEADLINE
  CALENDAR_EVENT
  SYSTEM
}

model ChatHandoverAcknowledgment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  channelId   String   @map("channel_id")
  messageId   String   @map("message_id")
  shiftPeriod String   @map("shift_period")
  userId      String   @map("user_id") @db.Uuid
  userName    String   @map("user_name")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([workspaceId])
  @@index([channelId])
  @@index([messageId])
  @@map("chat_handover_acknowledgments")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  type        NotificationType @default(SYSTEM)
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false) @map("is_read")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  user        User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  projectId    String?             @map("project_id") @db.Uuid
  issueKey     String?             @map("issue_key")
  type         String              @default("TASK")
  title        String
  description  String?
  status       TaskStatus          @default(TODO)
  priority     TaskPriority        @default(MEDIUM)
  storyPoints  Int?                @map("story_points")
  startDate    DateTime?           @map("start_date")
  dueDate      DateTime?           @map("due_date")
  assigneeId   String?             @map("assignee_id") @db.Uuid
  createdById  String              @map("created_by_id") @db.Uuid
  parentTaskId String?             @map("parent_task_id") @db.Uuid
  sprintId     String?             @map("sprint_id") @db.Uuid
  labels       String[]            @default([])
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User                @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parentTask   Task?               @relation("TaskParentChild", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]              @relation("TaskParentChild")
  sprint       Sprint?             @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  comments     TaskComment[]
  checklists   TaskChecklistItem[]
  activities   TaskActivity[]
  attachments  TaskAttachment[]
  dependencies TaskDependency[]    @relation("TaskSourceDependencies")
  dependedOnBy TaskDependency[]    @relation("TaskTargetDependencies")

  @@index([workspaceId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([sprintId])
  @@index([parentTaskId])
  @@map("tasks")
}

model Project {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  name        String
  key         String
  description String?
  category    String?
  type        String             @default("PUBLIC") // PUBLIC or PRIVATE
  status      String             @default("ACTIVE")
  color       String             @default("#7C3AED")
  ownerId     String             @map("owner_id") @db.Uuid
  startDate   DateTime?          @map("start_date")
  targetDate  DateTime?          @map("target_date")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  members     ProjectMember[]
  sprints     Sprint[]
  activities  TaskActivity[]
  milestones  ProjectMilestone[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  name        String
  goal        String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("sprints")
}

model TaskActivity {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  action      String    // CREATED, STATUS_CHANGED, ASSIGNED, PRIORITY_CHANGED, DUE_DATE_CHANGED, COMMENT_ADDED, ATTACHMENT_ADDED, SPRINT_CHANGED, TITLE_CHANGED, DESCRIPTION_CHANGED
  field       String?
  oldValue    String?   @map("old_value")
  newValue    String?   @map("new_value")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("task_activities")
}

model TaskAttachment {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fileName    String    @map("file_name")
  fileUrl     String    @map("file_url")
  fileSize    Int?      @map("file_size")
  fileType    String?   @map("file_type")
  storagePath String?   @map("storage_path")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
  @@map("task_attachments")
}

model TaskDependency {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  dependsOnTaskId  String    @map("depends_on_task_id") @db.Uuid
  type             String    @default("BLOCKS") // BLOCKS, BLOCKED_BY
  createdAt        DateTime  @default(now()) @map("created_at")

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task      @relation("TaskSourceDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask    Task      @relation("TaskTargetDependencies", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
  @@map("project_milestones")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model ScheduledMeeting {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([startTime])
  @@map("scheduled_meetings")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkspaceJoinRequest {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relations
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@map("workspace_join_requests")
}

